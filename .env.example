# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_BOT_USERNAME=p1_tournament_bot
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=change-me
WEBHOOK_URL=https://example.com/p1bot/webhook.php

# Bot owner (author): telegram user id. Owns the default balance scale.
BOT_OWNER_TG_ID=0

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Database (MySQL / MariaDB)
DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=p1bot;charset=utf8mb4"
DB_USER=p1bot
DB_PASSWORD=secret

# Tournament defaults
DEFAULT_MAX_PLAYERS=24
# 1 = any player may create tournaments, 0 = only chat admins / owner
ANYONE_CAN_CREATE_TOURNAMENT=0
