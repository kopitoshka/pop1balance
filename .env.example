# --- Telegram ---------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAbbbCCCdddEEE
# Bot username without '@' (e.g. pop1_tournament_bot)
TELEGRAM_BOT_USERNAME=pop1_tournament_bot
# Random string (A-Z a-z 0-9 _ -, up to 256 chars). Telegram sends it back in a header.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public HTTPS URL of public/webhook.php
WEBHOOK_URL=https://pop1.example.com/webhook.php

# Bot owner (author): your numeric Telegram user id. Owns the default balance scale
# and is an admin in every chat.
BOT_OWNER_TG_ID=0

# --- OpenAI -----------------------------------------------------------------
# Empty key = AI off: the bot answers mentions with a short help text, slash commands still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT=30

# --- Database (MySQL / MariaDB) ---------------------------------------------
DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=p1bot;charset=utf8mb4"
# or instead of DB_DSN: DB_HOST, DB_PORT, DB_NAME
DB_USER=p1bot
DB_PASSWORD=secret

# --- Behaviour ---------------------------------------------------------------
DEFAULT_MAX_PLAYERS=24
# 1 = any player may create tournaments (override). 0 = only users who share an active group
# with both the bot and BOT_OWNER_TG_ID (the owner can always create).
ANYONE_CAN_CREATE_TOURNAMENT=0
# How long Telegram chat admins are cached in the admins table
ADMINS_CACHE_MINUTES=10
# AI dialog memory lifetime
CONVERSATION_TTL_MINUTES=30
# The bot's name the AI uses when she introduces herself (she always speaks in the feminine gender).
# Empty = no name.
BOT_PERSONA_NAME=
# Cron: reminders N minutes before start, comma-separated
REMINDER_MINUTES=60,15
# Cron: running -> finished this many hours after start
FINISH_AFTER_HOURS=4
# Minutes before starts_at when registration auto-closes for players (join/leave/lineups).
# Organizer and chat admins can still change lineups. 0 = off (only manual /close).
REGISTRATION_CLOSE_MINUTES=20
# 1 = at every REMINDER_MINUTES mark (60 and 15 by default) post the short reminder with the
# sign-up button into every active group the bot is in (deduped per group+minutes). 0 = off.
REMIND_ALL_GROUPS=1

# --- Logging -------------------------------------------------------------------
# debug | info | error (default info). info: one line per update with the decision, AI and
# Telegram API calls; debug: also the full raw update JSON. Logs: storage/logs/bot-YYYY-MM-DD.log
LOG_LEVEL=info
# Readable per-user dialogs (user messages + bot replies, plain text):
# storage/logs/dialogs/<username>.log or id<telegram id>.log. 1 = on (default), 0 = off.
DIALOG_LOG=1
